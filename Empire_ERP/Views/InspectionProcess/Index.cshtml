@* crop modal *@
<div class="modal fade cropper-modal-lg" id="cropperModal" tabindex="-1" role="dialog" aria-labelledby="cropperModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cropperModalLabel">Crop Inspection Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="card text-left shadow-none border">
                        <div class="card-body">
                            <div class="img-container" style="max-height: 500px; background-color: #f8f9fa; display: flex; justify-content: center; align-items: center; overflow: hidden;">
                                <img id="cropperImage" src="" style="max-width: 100%; display: block;">
                            </div>
                        </div>
                        <div class="card-footer bg-transparent d-flex justify-content-end gap-2 py-3">
                            <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary" id="cropAndSave">
                                <i class="fa fa-crop me-1"></i> Apply Crop
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


