<style>


    .radio-input input {
        display: none;
    }

    .radio-input {
        --container_width: 120px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background-color: #fff;
        color: #000;
        width: var(--container_width);
        height: 22px;
        overflow: hidden;
        border: 1px solid rgba(53, 52, 52, 0.2);
        font-size: 12px;
    }

    .knockoff-heading {
        background-color: #055a87; /* 🔹 heading ka color */
        color: white; /* text color */
        padding: 2px 22px;
        margin-top: 20px;
        display: inline-block;
        clip-path: polygon(0 0, 92% 0, 100% 100%, 0% 100%); /* right side slope */
    }

    .radio-input label {
        width: 100%;
        height: 70%;
        padding: 0;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: end;
        z-index: 2;
        font-weight: 600;
        line-height: 0.5;
    }


    .selection {
        display: none;
        position: absolute;
        height: 100%;
        width: calc(var(--container_width)/3);
        z-index: 0;
        left: 0;
        top: 0;
        transition: 0.15s ease;
    }

    .radio-input label:has(input:checked) {
        color: #fff;
    }


        .radio-input label:has(input:checked) ~ .selection {
            display: inline-block;
            transition: 0.15s ease;
        }

    .radio-input label:nth-child(1):has(input:checked) ~ .selection {
        transform: translateX(calc(var(--container_width) * 0/3));
        background-color: #055a87;
    }

    .radio-input label:nth-child(2):has(input:checked) ~ .selection {
        transform: translateX(calc(var(--container_width) * 1/3));
        background-color: #51bb25;
    }

    .radio-input label:nth-child(3):has(input:checked) ~ .selection {
        transform: translateX(calc(var(--container_width) * 2/3));
        background-color: #dc3545;
    }



    .nrcBtnCommon {
        border: 1px solid rgba(53, 52, 52, 0.2);
        border-radius: 6px;
        height: 25px;
    }

        .nrcBtnCommon button {
            font-size: 12px;
            font-weight: 600;
            padding: 3px 16px !important;
        }

    /* Normal row aur alternating row dono ke liye color enforce karein */
    .dx-datagrid-rowsview .dx-data-row.danger-row,
    .dx-datagrid-rowsview .dx-data-row.danger-row.dx-row-alt {
        background-color: #ffcccc !important;
        color: #b71c1c !important;
    }

    /* Cell level par bhi reset (kabhi kabhi cell ka background alag hota hai) */
    .danger-row td {
        background-color: inherit !important;
        color: inherit !important;
    }

    /* Custom status classes */
    /* Label ka font size set karne ke liye */
    .audit-label {
        font-size: 20px !important;
        font-weight: 600;
    }

    /* Input box ki height aur font barhane ke liye */
    .audit-input {
        height: 45px; /* Height yahan se adjust karein */
        font-size: 18px; /* Box ke andar ka text bhi thoda bada lagega */
    }

    .status-pass {
        background-color: #d4edda !important;
        color: #155724 !important;
        border-color: #c3e6cb !important;
    }

    .status-fail {
        background-color: #f8d7da !important;
        color: #721c24 !important;
        border-color: #f5c6cb !important;
    }

</style>

